  <diagram name="Безопасность данных" id="data-security">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1574" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="center" value="Безопасность данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3864;fontColor=#FFFFFF;strokeColor=#0B1F3A;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1250" y="759" width="200" height="76" as="geometry"/>
