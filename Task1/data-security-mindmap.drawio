          <mxGeometry x="2030" y="210" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="Каталог воспроизводим из систем-источников (client-mart-db) и резервных копий" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#82B366;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="2310" y="210" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="Искажение данных — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="2030" y="360" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="Подмена цен/статусов/характеристик на витрине вводит клиентов в заблуждение — репутационный и юридический риск" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="2310" y="360" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="Некачественные данные — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="2030" y="510" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="Неактуальный каталог (проданный объект показан доступным, неверная цена) снижает доверие и конверсию" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="2310" y="510" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="Обесценивание данных — незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="2030" y="660" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="Публичные данные не теряют ценность от широкого доступа" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#82B366;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="2310" y="660" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="Внутренние данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E5CB8;fontColor=#FFFFFF;strokeColor=#1F3F80;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1490" y="1177" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="• Себестоимость и внутренний статус фонда недвижимости&#10;• Планы и история ремонта (текущий и капитальный)&#10;• Операционные данные менеджеров (воронка продаж)&#10;• Агрегированные отчёты и витрины BI" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#EAF0FB;strokeColor=#9DB7E0;fontSize=11;fontColor=#16243B" vertex="1" parent="1">
          <mxGeometry x="1720" y="1144" width="270" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="Утечка данных — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="2030" y="880" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="Раскрытие себестоимости/фонда/планов даёт преимущество конкурентам; не ПДн — ущерб ограничен коммерческим" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="2310" y="880" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="Потеря данных — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="2030" y="1030" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="Потеря истории ремонта и операционных данных нарушает обязательства перед собственниками; восстановление частичное" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="2310" y="1029" width="350" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="Искажение данных — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="2030" y="1180" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="Искажённые планы/история работ ведут к ошибочным решениям и срыву обязательств (напр., неверная история капремонта)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="2310" y="1180" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="Некачественные данные — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="2030" y="1330" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="Несколько несинхронизированных точек регистрации и отсутствие контроля потоков → дубликаты и противоречия между системами" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="2310" y="1329" width="350" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="Обесценивание данных — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="2030" y="1480" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="Без управления потоками и каталогизации данные деградируют и теряют пригодность для BI/ML — блокирует новые data-продукты" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="2310" y="1479" width="350" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="Конфиденциальные данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E5CB8;fontColor=#FFFFFF;strokeColor=#1F3F80;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1020" y="357" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="• ПДн клиентов: ФИО, телефон, email, расширенная форма (паспортные данные)&#10;• ПДн собственников&#10;• Данные онлайн-сделок: договоры, документы для госорганов (СМЭВ)&#10;• Данные ЖКУ: лицевые счета, начисления, платежи&#10;• Данные CRM (клиенты и собственники)&#10;• Данные бухгалтерского учёта" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#EAF0FB;strokeColor=#9DB7E0;fontSize=11;fontColor=#16243B" vertex="1" parent="1">
          <mxGeometry x="710" y="309" width="270" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="Утечка данных — критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="60" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="ПДн (152-ФЗ), платёжные и сделочные данные; нет изоляции (чужие ФИО в ЛК, партнёр УК видит данные чужой УК), API без политик → массовая утечка, штрафы, репутация" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#B85450;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="59" width="350" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="Потеря данных — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="210" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="Потеря договоров сделок/лицевых счетов/бухгалтерии = юридические и финансовые последствия; смягчается резервным копированием" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="209" width="350" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="Искажение данных — критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="360" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="Искажение данных сделки/начислений ЖКУ/бухучёта = прямой финансовый и юридический ущерб, споры, неверные платежи" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#B85450;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="Некачественные данные — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="510" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="Дубли клиентов из-за нескольких точек регистрации, рассинхронизация ПДн → ошибки в ЛК и неверные начисления" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="Обесценивание данных — незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="660" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n37" value="Для ПДн доминируют утечка и искажение; падение бизнес-ценности второстепенно" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#82B366;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="Секретные данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E5CB8;fontColor=#FFFFFF;strokeColor=#1F3F80;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1020" y="1177" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="• Учётные данные и секреты аутентификации: пароли/хэши, токены (Keycloak)&#10;• Учётные записи Active Directory&#10;• Ключи и секреты интеграций: СМЭВ, платёжная система, API УК&#10;• Команды управления «Умным домом»: замок квартиры, автоматика" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;fillColor=#EAF0FB;strokeColor=#9DB7E0;fontSize=11;fontColor=#16243B" vertex="1" parent="1">
          <mxGeometry x="710" y="1137" width="270" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="Утечка данных — критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="880" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="Компрометация паролей/токенов/ключей → захват учёток, обход аутентификации, доступ ко всем системам и к управлению умным домом (замок квартиры) — угроза данным и физической безопасности" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#B85450;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="872" width="350" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="Потеря данных — значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="1030" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="Большинство секретов ротируются, но потеря ключа шифрования резервных копий = безвозвратная потеря зашифрованных данных" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#D6B656;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="1029" width="350" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n44" value="Искажение данных — критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="1180" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n45" value="Подмена прав/ролей в AD/ACL или несанкционированные команды умному дому (отпереть замок) = захват доступа и угроза физической безопасности и имуществу" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#B85450;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="1179" width="350" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="Некачественные данные — незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="1330" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="К ключам/учёткам понятие «качество данных» слабо применимо (валидны/невалидны)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#82B366;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="350" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="Обесценивание данных — незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="430" y="1480" width="240" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="Секреты подлежат ротации; обесценивание — не ключевой риск" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FBFBFB;strokeColor=#82B366;fontSize=10;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="40" y="1480" width="350" height="54" as="geometry"/>
        </mxCell>
